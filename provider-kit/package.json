{
  "name": "satchel-pay-server",
  "version": "0.1.0",
  "description": "Charge AI agents per API call in Bitcoin Cash (bch-sc402, HTTP 402): signed payment challenges, 0-conf payment verification and idempotent paid retries for any Fetch API server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "http-402",
    "x402",
    "payments",
    "ai-agent",
    "paywall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hms1499/satchel.git",
    "directory": "agentvault/provider-kit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@electrum-cash/network": "^4.4.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
