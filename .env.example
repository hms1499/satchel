# Network: chipnet (default, for development) or mainnet (demo / submission)
NEXT_PUBLIC_BCH_NETWORK=chipnet

# Server secrets (>= 32 chars). Generate with: openssl rand -hex 32
# AGENT_MASTER_SEED derives every vault's agent key. Rotating it orphans existing vaults' agents
# (owners can still withdraw).
AGENT_MASTER_SEED=
# PROVIDER_SEED derives the pay-per-call provider addresses and signs x402 challenges.
PROVIDER_SEED=

# Agent mode: "scripted" (default, a fixed research plan) or "llm". The LLM is opt-in: Vercel injects
# VERCEL_OIDC_TOKEN into every deployment, which must not switch the demo to an untested path by itself.
AGENT_MODE=scripted
# LLM provider. GROQ_API_KEY wins when set: Groq's free tier (no card; 1K requests/day, 8K tokens/minute per model).
# The agent uses GROQ_MODEL (default openai/gpt-oss-120b), deep-analysis GROQ_TOOL_MODEL (default openai/gpt-oss-20b),
# so they never share a per-model rate limit. Without it: the Vercel AI Gateway (AGENT_MODEL / TOOL_MODEL), which needs
# AI_GATEWAY_API_KEY or the Vercel OIDC token, and a card on the Vercel team.
GROQ_API_KEY=
AI_GATEWAY_API_KEY=

# Hackathon banner (BCH BLAZE requirement)
NEXT_PUBLIC_SLIDES_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_EMBER_ADDRESS=

# Suggested sellers shown as checkboxes in the create form (optional). A JSON array of
# { "name": "<1-32 chars>", "origin": "https://…", "payTo": "<CashAddr on this network>", "description": "…" }.
# A malformed value makes /api/config fail on its first request with an error naming this variable.
SATCHEL_SELLERS=

# Paid `deep-analysis` tool: set TOOL_LLM=on to call a real model (needs GROQ_API_KEY, AI_GATEWAY_API_KEY or the OIDC token),
# otherwise it returns a placeholder answer. Independent of AGENT_MODE. Set a spend budget for the AI Gateway in the
# Vercel dashboard before turning this on.
TOOL_LLM=off
TOOL_MODEL=anthropic/claude-haiku-5.5
