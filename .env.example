# Network: chipnet (default, for development) or mainnet (demo / submission)
NEXT_PUBLIC_BCH_NETWORK=chipnet

# Server secrets (>= 32 chars). Generate with: openssl rand -hex 32
# AGENT_MASTER_SEED derives every vault's agent key. Rotating it orphans existing vaults' agents
# (owners can still withdraw).
AGENT_MASTER_SEED=
# PROVIDER_SEED derives the pay-per-call provider addresses and signs x402 challenges.
PROVIDER_SEED=

# LLM for the agent (AI SDK via Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Hackathon banner (BCH BLAZE requirement)
NEXT_PUBLIC_SLIDES_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_EMBER_ADDRESS=
